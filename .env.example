# Copiez ce fichier en `.env.local` (développement) ou définissez ces variables chez votre hébergeur.

# URL publique du site (canonical + Open Graph), ex. https://tanger.exemple.ma
NEXT_PUBLIC_SITE_URL=

# Vidéo de présentation (VSL) : lien YouTube ou fichier local, ex. /videos/cdd-tanger.mp4
# Vide = aperçu « bientôt disponible », sans bouton de lecture.
NEXT_PUBLIC_VIDEO_URL=

# ── Intégration GoHighLevel (variables SERVEUR, jamais exposées au navigateur) ──
# Choisissez UNE des deux options. Si aucune n'est définie, le formulaire reste en « mode démonstration ».

# Option A — Webhook entrant GoHighLevel (recommandé : conserve le formulaire du site).
# Automation > Workflows > déclencheur « Inbound Webhook » > copiez l'URL.
GHL_WEBHOOK_URL=

# Option B — Formulaire GoHighLevel intégré (iframe). Sites > Forms > Integrate > copiez le lien du formulaire.
GHL_FORM_EMBED_URL=
# Hauteur initiale de l'iframe en pixels (facultatif, 900 par défaut).
GHL_FORM_EMBED_HEIGHT=
